{{!
    @template tool_flowboard/actor_list

    Every flow's actor: the account it runs as, and what it may do.

    Context variables required for this template:
    * rows - One row per actor
    * hasrows - Whether there are any

    Example context (json):
    {
        "rows": [
            {
                "flowname": "Welcome to the forums",
                "flowstatus": "live",
                "username": "flow.welcome-forums",
                "suspended": false,
                "capabilities": ["mod/forum:managesubscriptions"],
                "hascapabilities": true
            }
        ],
        "hasrows": true
    }
}}
<div class="tool-flowboard-actors">
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <caption class="sr-only">{{#str}} actors:heading, tool_flowboard {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} actors:flow, tool_flowboard {{/str}}</th>
                    <th scope="col">{{#str}} actors:account, tool_flowboard {{/str}}</th>
                    <th scope="col">{{#str}} actors:status, tool_flowboard {{/str}}</th>
                    <th scope="col">{{#str}} actors:capabilities, tool_flowboard {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <td>{{flowname}}</td>
                    <td><code>{{username}}</code></td>
                    <td>
                        {{#suspended}}
                        <span class="badge badge-secondary">{{#str}} actors:suspended, tool_flowboard {{/str}}</span>
                        {{/suspended}}
                        {{^suspended}}
                        <span class="badge badge-success">{{#str}} actors:active, tool_flowboard {{/str}}</span>
                        {{/suspended}}
                    </td>
                    <td>
                        {{#hascapabilities}}
                        <code class="small">{{#capabilities}}{{.}} {{/capabilities}}</code>
                        {{/hascapabilities}}
                        {{^hascapabilities}}
                        <span class="text-muted small">{{#str}} actors:none, tool_flowboard {{/str}}</span>
                        {{/hascapabilities}}
                    </td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}

    {{^hasrows}}
    <div class="alert alert-info">{{#str}} actors:noflows, tool_flowboard {{/str}}</div>
    {{/hasrows}}
</div>
