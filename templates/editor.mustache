{{!
    @template tool_flowboard/editor

    The canvas's own mount point. Everything inside is filled in by
    tool_flowboard/canvas/main once the page has loaded.

    Context variables required for this template:
    * flowid - The flow being edited, or 0 for a new one
    * listurl - Where "back to flows" and a successful publish lead

    Example context (json):
    {
        "flowid": 1,
        "listurl": "/admin/tool/flowboard/index.php"
    }
}}
<div id="tool-flowboard-editor" data-listurl="{{listurl}}">
    <p class="tool-flowboard-intro">
        {{#str}} flow:editorintro, tool_flowboard {{/str}}
    </p>
    <div class="tool-flowboard-toolbar">
        <div class="btn-group" role="group" aria-label="{{#str}} flow:viewmode, tool_flowboard {{/str}}">
            <button type="button" class="btn btn-outline-secondary active" data-role="view-toggle" data-view="canvas"
                    title="{{#str}} flow:viewcanvas_help, tool_flowboard {{/str}}">
                {{#str}} flow:viewcanvas, tool_flowboard {{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary" data-role="view-toggle" data-view="list"
                    title="{{#str}} flow:viewlist_help, tool_flowboard {{/str}}">
                {{#str}} flow:viewlist, tool_flowboard {{/str}}
            </button>
        </div>
        <button type="button" class="btn btn-outline-secondary" data-action="undo"
                title="{{#str}} flow:undo_help, tool_flowboard {{/str}}">
            {{#str}} flow:undo, tool_flowboard {{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary" data-action="redo"
                title="{{#str}} flow:redo_help, tool_flowboard {{/str}}">
            {{#str}} flow:redo, tool_flowboard {{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary" data-action="align"
                title="{{#str}} flow:align_help, tool_flowboard {{/str}}">
            {{#str}} flow:align, tool_flowboard {{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary" data-action="test"
                title="{{#str}} flow:test_help, tool_flowboard {{/str}}">
            {{#str}} flow:test, tool_flowboard {{/str}}
        </button>
        <span class="tool-flowboard-toolbar__spacer"></span>
        <span class="tool-flowboard-toolbar__indicator" data-role="autosave-indicator"></span>
        <button type="button" class="btn btn-primary" data-action="publish"
                title="{{#str}} flow:publish_help, tool_flowboard {{/str}}">
            {{#str}} flow:publish, tool_flowboard {{/str}}
        </button>
    </div>
    <div class="tool-flowboard-alert tool-flowboard-alert--error" data-role="publish-error" hidden></div>
    <div class="tool-flowboard-editor__body">
        <div class="tool-flowboard-palette"></div>
        <div class="tool-flowboard-canvas"></div>
        <ol class="tool-flowboard-listview" hidden></ol>
        <div class="tool-flowboard-inspector"></div>
    </div>
    <div class="tool-flowboard-minimap"></div>
</div>
